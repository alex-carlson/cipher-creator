{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "codebreaker",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-10-12",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
    },
    "kv_namespaces": [
        {
            "binding": "passphrase",
            "id": "305779bcedd045898dde60cd4d681950"
        }
    ],
}
